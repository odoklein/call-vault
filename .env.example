# --- Database (this app's OWN Postgres, separate from the CRM's) ---
DATABASE_URL="postgresql://user:password@host:5432/call_vault"

# --- Redis (BullMQ) — can be a dedicated instance or shared with the CRM's email queue ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- WithAllo ---
ALLO_API_KEY=""
# Comma-separated E.164 numbers to sync, e.g. "+33600000001,+33600000002"
ALLO_NUMBERS=""
CALL_ENRICHMENT_ALLO_PAGE_SIZE="100"
CALL_ENRICHMENT_ALLO_429_RETRIES="6"
CALL_ENRICHMENT_ALLO_429_BASE_MS="750"
CALL_ENRICHMENT_ALLO_NETWORK_RETRIES="3"
CALL_ENRICHMENT_ALLO_NETWORK_RETRY_MS="1500"
CALL_ENRICHMENT_ALLO_FETCH_TIMEOUT_MS="30000"
# How often the repeatable sync job runs per line (cron pattern)
ALLO_SYNC_CRON="*/2 * * * *"
# Safety cap: max pages walked forward per line per sync run before giving up
ALLO_SYNC_MAX_PAGES="20"

# --- Audio storage ---
# "local" for dev (writes under ./uploads), "s3" for production
STORAGE_PROVIDER="local"
ASW_S3_BUCKET=""
ASW_REGION="us-east-1"
ASW_ACCESS_KEY_ID=""
ASW_SECRET_ACCESS_KEY=""

# --- CRM <-> vault auth (mint one key per direction with scripts/seed-providers.ts or an admin route) ---
# The CRM must send this as: Authorization: Bearer <key>
