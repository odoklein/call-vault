# --- Database (this app's OWN Postgres, separate from the CRM's) ---
DATABASE_URL="postgresql://user:password@host:5432/call_vault"

# --- Redis (BullMQ) — can be a dedicated instance or shared with the CRM's email queue ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- WithAllo ---
ALLO_API_KEY=""
# Comma-separated E.164 numbers to sync, e.g. "+33600000001,+33600000002"
ALLO_NUMBERS=""
CALL_ENRICHMENT_ALLO_PAGE_SIZE="100"
CALL_ENRICHMENT_ALLO_429_RETRIES="6"
CALL_ENRICHMENT_ALLO_429_BASE_MS="750"
CALL_ENRICHMENT_ALLO_NETWORK_RETRIES="3"
CALL_ENRICHMENT_ALLO_NETWORK_RETRY_MS="1500"
CALL_ENRICHMENT_ALLO_FETCH_TIMEOUT_MS="30000"
# How often the repeatable sync job runs per line (cron pattern)
ALLO_SYNC_CRON="*/2 * * * *"
# Max pages walked per line per incremental run. Hitting it is not a loss: the rest is handed to
# the backfill (SyncCursor.backfill*) and read on the next ticks.
ALLO_SYNC_MAX_PAGES="20"

# --- Never-miss sync (lib/sync/walk.ts) ---
# Every run re-reads calls this far behind the cursor, so transcript/summary/recording that the
# provider attaches after the call are captured instead of frozen at the first sighting.
SYNC_LOOKBACK_MINUTES="360"
# Once a day, a deeper re-read for content that settles very late.
SYNC_DEEP_LOOKBACK_MINUTES="4320"
SYNC_DEEP_SWEEP_EVERY_MINUTES="1440"
# History import speed (npm run backfill -- --days=31): pages per line per sync tick.
SYNC_BACKFILL_PAGES_PER_RUN="5"

# --- Recording mirror queue ---
RECORDING_MIRROR_ATTEMPTS="6"
RECORDING_MIRROR_CONCURRENCY="1"
# Min interval between two media downloads — they hit the same Allo account as the list API.
RECORDING_MIRROR_MIN_INTERVAL_MS="2000"

# --- CRM link (read-only) ---
# A Postgres role on the CRM database with SELECT on "User", "Action", "Contact", "Company",
# "Campaign", "Mission" only. Unset = no CRM linking and no line auto-provisioning.
CRM_DATABASE_URL=""
CRM_SYNC_EVERY_MINUTES="5"
# First run mirrors CALL actions this far back (covers a 1-month backfill).
CRM_ACTIONS_INITIAL_DAYS="35"
# Create + sync a Line for every CRM user with an alloPhoneNumber the vault doesn't know yet.
CRM_AUTO_PROVISION_LINES="true"
PHONE_DEFAULT_COUNTRY="FR"
# A call this long counts as a conversation (expected to have a transcript) in coverage reports.
COVERAGE_CONVERSATION_MIN_SEC="20"

# --- Dashboard (HTTP Basic auth; the dashboard shows prospects' numbers + summaries) ---
# Unset password = dashboard disabled (503). /api/* is unaffected (Bearer vault keys).
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD=""

# --- Audio storage ---
# "local" for dev (writes under ./uploads — only durable if that path is on a persistent volume!),
# "s3" for AWS S3, "minio" for a self-hosted S3-compatible bucket (e.g. on the same VPS).
STORAGE_PROVIDER="local"

# STORAGE_PROVIDER=s3
ASW_S3_BUCKET=""
ASW_REGION="us-east-1"
ASW_ACCESS_KEY_ID=""
ASW_SECRET_ACCESS_KEY=""

# STORAGE_PROVIDER=minio — same var names as captainprospect-crm's lib/storage/minio.ts
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY_ID=""
MINIO_SECRET_ACCESS_KEY=""
MINIO_REGION="us-east-1"
MINIO_BUCKET="call-vault"

# --- CRM <-> vault auth (mint one key per direction with scripts/seed-providers.ts or an admin route) ---
# The CRM must send this as: Authorization: Bearer <key>
