generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PROVIDERS & LINES
// ============================================

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum RecordingStatus {
  NONE // provider had no recording
  PENDING // call seen, recording not fetched/mirrored yet
  STORED // mirrored to our own storage — recordingKey is authoritative
  FAILED // fetch/upload failed after every retry; scripts/remirror-recordings.ts can try again
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One row per telephony/call-intelligence provider (allo, leexi, twilio, aircall, ringover, ...).
/// Adding a provider is a new row + a new adapter under lib/providers/<slug>/ — nothing else in
/// the schema changes.
model Provider {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  /// Provider-specific settings that aren't secrets (secrets stay in env vars).
  config      Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines       Line[]
  calls       Call[]
  syncCursors SyncCursor[]

  @@index([isActive])
}

/// A phone line / number known to a provider. For poll-based providers (Allo, Leexi) this is what
/// gets synced on a schedule. For click-to-dial providers (Twilio, Aircall, Ringover) this is the
/// caller-id used when initiating a call.
model Line {
  id             String   @id @default(cuid())
  providerId     String
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalNumber String
  label          String?
  /// Free-form pointer back to the CRM (a User id or email) — never a real FK, the two apps
  /// have separate databases on purpose (see plan: "Why a separate DB").
  crmOwnerRef    String?
  /// CRM User.id of the SDR this number belongs to, resolved from CRM User.alloPhoneNumber by the
  /// directory sync (lib/crm/directory-sync.ts). This is what lets the matcher refuse to attach
  /// one SDR's call to another SDR's action.
  crmUserId      String?
  /// "env" = seeded from ALLO_NUMBERS, "crm" = auto-provisioned from a CRM User.alloPhoneNumber.
  source         String   @default("env")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  syncCursors SyncCursor[]
  calls       Call[]
  clients     ClientLine[]

  @@unique([providerId, externalNumber])
  @@index([isActive])
  @@index([crmUserId])
}

/// Per (provider, line) sync state. Poll-based adapters walk newest-first and stop a little before
/// `lastSyncedAt` (the lookback window), so content that settles after the call — transcript,
/// summary, recording — is picked up on a later pass instead of being frozen at its first sighting.
model SyncCursor {
  id               String    @id @default(cuid())
  providerId       String
  provider         Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  lineId           String
  line             Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  /// Newest call start time already stored for this line.
  lastSyncedAt     DateTime?
  lastSyncAt       DateTime? // wall-clock time of the last successful run (for staleness alerts)
  /// Last run that used the long (deep sweep) lookback, to catch content that settled very late.
  lastDeepSweepAt  DateTime?
  lastError        String?
  /// History backfill: walk pages down to this date. Set by scripts/backfill.ts, or automatically
  /// when an incremental run hits its page cap before reaching the lookback boundary (a gap).
  backfillUntil    DateTime?
  /// Page index the backfill resumes from. Allo lists newest-first, so calls arriving meanwhile
  /// only push older ones to later pages — resuming by index can repeat a call, never skip one.
  backfillNextPage Int?
  backfillDoneAt   DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([providerId, lineId])
}

// ============================================
// CALLS
// ============================================

/// The vault's own record of a call, provider-agnostic. The CRM reads it through /api/calls*,
/// never directly.
model Call {
  id             String        @id @default(cuid())
  providerId     String
  provider       Provider      @relation(fields: [providerId], references: [id])
  providerCallId String
  /// The line this call was synced from (= which SDR placed/received it, via Line.crmUserId).
  lineId         String?
  line           Line?         @relation(fields: [lineId], references: [id], onDelete: SetNull)
  direction      CallDirection @default(OUTBOUND)
  fromNumber     String
  toNumber       String
  /// The other party in E.164 (toNumber for OUTBOUND, fromNumber for INBOUND). All phone lookups
  /// go through this column — equality on an index, not a substring scan.
  remoteNumber   String?
  /// Provider's raw status/outcome string (kept as-is, not modeled as an enum — every provider
  /// has a different vocabulary).
  status         String?
  startedAt      DateTime?
  endedAt        DateTime?
  durationSec    Int           @default(0)

  /// Our own storage key (S3 or local). Provider media URLs are fetched exactly once and never
  /// referenced again once recordingStatus = STORED.
  recordingKey       String?
  recordingStatus    RecordingStatus @default(NONE)
  /// Plain-text transcript, one "SPEAKER: text" turn per line (kept for full-text search and for
  /// the CRM's existing /api/calls consumers).
  transcription      String?         @db.Text
  /// Same transcript, structured: [{ speaker: "SDR" | "PROSPECT" | "AGENT", text, start?, end? }].
  transcriptSegments Json?
  /// When the transcript first appeared in the vault — the gap to startedAt is the provider's
  /// transcription latency, and a long conversation with this still null is a missing transcript.
  transcriptAt       DateTime?
  aiSummary          String?         @db.Text
  aiExtraction       Json?
  /// Full provider payload from the latest sighting, kept for debugging / re-processing without
  /// another API call.
  rawPayload         Json
  /// Last time the provider's list returned this call.
  lastSeenAt         DateTime?

  /// Trigger-maintained (see migration 20261009000000_never_miss_transcripts): French full-text
  /// index over aiSummary (weight A) + transcription (weight B). Never written by the app.
  searchVector Unsupported("tsvector")?

  consentAnnounced Boolean   @default(false)
  purgeAfter       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookDeliveries WebhookDelivery[]
  crmAction         CrmAction?

  @@unique([providerId, providerCallId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([startedAt])
  @@index([remoteNumber, startedAt])
  @@index([lineId, startedAt])
  @@index([searchVector], type: Gin)
}

// ============================================
// CRM LINKS (read-only mirror — the vault never writes to the CRM)
// ============================================

enum MatchStatus {
  PENDING // not settled yet, or the SDR's line hasn't synced past the action time
  MATCHED // callId is set
  UNMATCHED // gave up after the match window — no vault call fits
  NO_PHONE // the action has no usable phone number to match on
}

enum MatchConfidence {
  HIGH // SDR's own line + same number + call ended within minutes of the action being logged
  MEDIUM // same number, plausible timing, but either the line owner is unknown or the gap is long
  LOW // same number only, weak timing
}

/// One CRM CALL action (Action.channel = CALL), mirrored by lib/crm/directory-sync.ts and matched
/// one-to-one to the vault Call it records by lib/linking/. The link lives here, in the vault —
/// the CRM's own Action row is never modified by this.
model CrmAction {
  /// CRM Action.id
  id              String           @id
  sdrUserId       String
  contactId       String?
  companyId       String?
  campaignId      String
  missionId       String
  clientId        String
  /// CRM ActionResult code (RAPPEL, MEETING_BOOKED, ...), as text.
  result          String
  /// CRM Action.createdAt — when the SDR logged the outcome, normally just after hanging up.
  loggedAt        DateTime
  /// E.164 candidates: meetingPhone, contact phone + additionalPhones, company phone + customData.
  phones          String[]

  callId          String?          @unique
  call            Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)
  matchStatus     MatchStatus      @default(PENDING)
  matchConfidence MatchConfidence?
  /// Human-readable why: "same SDR line, ended 1m before log".
  matchReason     String?
  matchedAt       DateTime?

  syncedAt        DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  @@index([loggedAt])
  @@index([matchStatus, loggedAt])
  @@index([sdrUserId, loggedAt])
  @@index([contactId])
  @@index([companyId])
  @@index([clientId, loggedAt])
}

/// Small key/value store for sync watermarks that don't belong to a provider line
/// (e.g. "crm.actions.watermark").
model SyncState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Outbound delivery ledger, vault -> CRM. Turns "the fiche didn't update" from a silent miss into
/// a visible, retryable row.
model WebhookDelivery {
  id            String                @id @default(cuid())
  callId        String
  call          Call                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  targetUrl     String
  status        WebhookDeliveryStatus @default(PENDING)
  attempt       Int                   @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  @@index([status])
  @@index([callId])
}

// ============================================
// CLIENTS (multi-tenant access to the vault)
// The Allo account and every line belong to the operator (Suzali Conseil, role ADMIN). A Client
// (e.g. Captain Prospect) sees exactly the calls of the lines granted to it in ClientLine —
// on the web board and through its API keys alike (lib/access.ts is the only place that decides).
// ============================================

enum UserRole {
  ADMIN // operator staff: every line, every client, all settings
  CLIENT // a client's user: their granted lines only, read-only
}

model Client {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines   ClientLine[]
  users   User[]
  apiKeys ApiKey[]
}

/// "Client X may see the calls of line Y" — past and future. No row, no visibility.
model ClientLine {
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineId      String
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  grantedAt   DateTime @default(now())
  /// User.id of the admin who granted it.
  grantedById String?

  @@id([clientId, lineId])
  @@index([lineId])
}

/// Web users. A CHECK constraint (migration 20261010000000_multi_client) enforces
/// ADMIN <=> clientId IS NULL and CLIENT <=> clientId IS NOT NULL.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// scrypt, see lib/auth/password.ts
  passwordHash String
  role         UserRole
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]

  @@index([clientId])
}

/// Server-side sessions: the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// API KEYS (services -> vault)
// ============================================

/// Same shape as the CRM's ApiKey model (lib/api-keys.ts / prisma/schema.prisma). clientId null =
/// operator key (every line, e.g. the integration key used before clients existed); clientId set =
/// that client's granted lines only.
model ApiKey {
  id                 String    @id @default(cuid())
  name               String
  keyHash            String    @unique
  keyPrefix          String
  allowedEndpoints   Json      @default("[]")
  rateLimitPerMinute Int       @default(60)
  rateLimitPerHour   Int       @default(1000)
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isActive           Boolean   @default(true)
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([keyHash])
  @@index([isActive])
  @@index([clientId])
}
